# Template unit: one instance per job spec.
#   systemctl --user start claude-job@market-review.service
#
# The instance name is the spec's basename in ~/.config/claude-jobs. The
# timer that fires this is generated by `claude-jobs install <name>`, which
# reads OnCalendar from the same spec.
[Unit]
Description=Scheduled Claude job: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
# The spec doubles as this unit's environment file, so a job can also set
# credentials or overrides that the runner and the prompt need.
EnvironmentFile=%h/.config/claude-jobs/%i.job
# Host-specific values (chat ids, tokens paths) that should not sit in the
# repository. Optional: a leading dash means a missing file is not an error.
EnvironmentFile=-%h/.config/claude-jobs/runtime.env
ExecStart=%h/.local/lib/claude-jobs/claude-job-run.sh %i
TimeoutStartSec=30min
Environment=HOME=%h
Environment=LC_ALL=C.UTF-8
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
